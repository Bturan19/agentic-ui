# --- LLM (Gemini / Vertex AI) ---
# Vertex AI icin (onerilen):
AGENT_MODEL=google-vertex:gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex, Application Default Credentials kullanir: `gcloud auth application-default login`

# Alternatif: Gemini Developer API (API key ile)
# AGENT_MODEL=google-gla:gemini-2.5-flash
# GEMINI_API_KEY=your-key

# --- BigQuery / MCP Toolbox ---
# MCP Toolbox calisirken doldurun; bos ise bigquery_query stub moduna duser (ornek veri doner).
# Ornek: TOOLBOX_MCP_URL=http://127.0.0.1:5000/mcp
TOOLBOX_MCP_URL=
BIGQUERY_PROJECT=your-gcp-project

# --- Pazaryeri backend API (back office) ---
# Bos ise mock backend kullanilir (veriler data/agentic_ui.db'de tutulur).
MARKETPLACE_API_BASE_URL=
MARKETPLACE_API_TOKEN=
MARKETPLACE_DRY_RUN=true

# --- Raporlama / analitik ---
# Sirket ici raporlama servisi (BQ vs.). Bos ise mock; POSTGRES_DSN doluysa Postgres.
REPORTING_API_BASE_URL=
REPORTING_API_TOKEN=

# --- PostgreSQL adaptoru (opsiyonel; uv sync --extra postgres) ---
POSTGRES_DSN=
PG_CAMPAIGNS_TABLE=campaigns
PG_CAMPAIGN_DAILY_TABLE=campaign_daily
PG_CATEGORY_DAILY_TABLE=category_product_daily

# --- Entegrasyon (sirket ici sistemler) ---
# Sinyal webhook'lari icin paylasilan token (bos ise /api/signals kapali).
INTEGRATION_TOKEN=
# Dis sistemlere olay bildirimi (approval_required, approval_resolved, campaign_action, run_finished).
EVENT_WEBHOOK_URL=

# --- Uygulama ---
DATABASE_PATH=data/agentic_ui.db
SCHEDULER_ENABLED=false
DAILY_REVIEW_CRON=0 9 * * *
WEEKLY_LEARNING_CRON=30 8 * * 1
